---
import { render } from "astro:content"
import SiteLayout from "../../layouts/SiteLayout.astro"
import TagList from "../../components/TagList.astro"
import { getPosts, localPath } from "../../lib/site"

export async function getStaticPaths() {
  return (await getPosts()).map((post) => ({
    params: { slug: post.id },
    props: { post },
  }))
}

const { post } = Astro.props
const { data } = post
const { Content } = await render(post)
const readingTime = Math.ceil((post.body?.match(/\S+/g)?.length ?? 0) / 225)
const date = data.date.toLocaleDateString("en-US", {
  year: "numeric", month: "long", day: "numeric", timeZone: "UTC",
})
---
<SiteLayout pageTitle={data.title} summary={data.description}>
  <article class="prose reading-prose mx-auto max-w-[68ch] break-words pb-6 sm:prose-lg">
    <h1 class="mb-4 font-display text-ink">{data.title}</h1>
    {data.description && <p class="mt-0 text-lg text-muted sm:text-xl">{data.description}</p>}
    <div class="mb-8 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-muted">
      <time datetime={data.date.toISOString()}>{date}</time>
      <div class="hidden h-4 w-px bg-line sm:block"></div>
      <span>{readingTime} min read</span>
      {data.tags.length > 0 && <div class="hidden h-4 w-px bg-line sm:block"></div>}
      <TagList tags={data.tags} />
    </div>
    <hr class="my-4 border-line" />
    <div class="markdown-content min-w-0 break-words"><Content /></div>
    <footer class="mt-8 border-t border-line pt-4">
      {data.tags.length > 0 && <div class="mb-4"><TagList tags={data.tags} /></div>}
      <div class="flex items-center justify-between">
        <a href={localPath("/")} class="text-base text-muted transition-colors hover:text-accent">← Home</a>
        <time datetime={data.date.toISOString()} class="text-base text-muted">{date}</time>
      </div>
    </footer>
  </article>
</SiteLayout>
