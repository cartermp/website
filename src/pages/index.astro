---
import { Content as Bio } from "../../content/pages/about.md"
import SiteLayout from "../layouts/SiteLayout.astro"
import ThemeToggle from "../components/ThemeToggle.astro"
import SocialLinks from "../components/SocialLinks.astro"
import PostList from "../components/PostList.astro"
import { getPosts, title } from "../lib/site"

const posts = await getPosts()
---
<SiteLayout>
  <div class="mx-auto max-w-[52rem]">
    <header class="home-intro rounded-[2rem_2rem_2rem_0.65rem] px-6 py-8 sm:px-10 sm:py-11">
      <div class="flex flex-wrap items-start justify-between gap-x-6 gap-y-4">
        <h1 class="font-display text-5xl leading-[0.98] font-medium tracking-[-0.055em] text-accent sm:text-7xl">{title}</h1>
        <ThemeToggle />
      </div>
      <section aria-label="About" class="home-about mt-6 max-w-[59ch] text-base leading-relaxed text-muted sm:text-lg">
        <div class="markdown-content min-w-0 break-words"><Bio /></div>
      </section>
      <SocialLinks />
    </header>
    <section aria-labelledby="posts" class="mt-9 sm:mt-12">
      <h2 id="posts" class="mb-3 px-2 font-display text-2xl font-medium tracking-tight text-ink sm:px-4">Posts</h2>
      <PostList posts={posts} />
    </section>
  </div>
</SiteLayout>
