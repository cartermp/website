---
import { getCollection, render } from "astro:content"
import SiteLayout from "../layouts/SiteLayout.astro"

export async function getStaticPaths() {
  return (await getCollection("pages")).map((page) => ({
    params: { slug: page.id },
    props: { page },
  }))
}

const { page } = Astro.props
const { Content } = await render(page)
---
<SiteLayout pageTitle={page.data.title} summary={page.data.description}>
  <article class="prose reading-prose mx-auto max-w-[68ch] break-words py-6 sm:prose-lg">
    <h1 class="mb-2 font-display text-ink">{page.data.title}</h1>
    {page.data.description && <p class="text-xl">{page.data.description}</p>}
    <div class="markdown-content min-w-0 break-words"><Content /></div>
  </article>
</SiteLayout>
