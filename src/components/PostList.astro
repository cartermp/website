---
import type { CollectionEntry } from "astro:content"
import TagList from "./TagList.astro"
import { postPath } from "../lib/site"

interface Props {
  posts: CollectionEntry<"posts">[]
  heading?: "h2" | "h3"
}

const { posts, heading: Heading = "h3" } = Astro.props
const postDate = new Intl.DateTimeFormat("en-US", {
  month: "short", day: "numeric", year: "numeric", timeZone: "UTC",
})
---
<ul class="post-list divide-y divide-line border-t border-line">
  {posts.map(({ id, data }) => (
    <li class="relative grid gap-1 px-2 py-5 transition-colors hover:bg-surface focus-within:bg-surface sm:grid-cols-[minmax(0,1fr)_auto] sm:gap-x-6 sm:px-4">
      <Heading class="font-display text-xl font-medium leading-snug tracking-tight text-ink sm:text-2xl">
        <a href={postPath(id)} class="post-title-link before:absolute before:inset-0 before:content-[''] decoration-1 underline-offset-4 hover:text-accent hover:underline focus-visible:underline"><span>{data.title}</span></a>
      </Heading>
      <time datetime={data.date.toISOString()} class="whitespace-nowrap text-sm leading-7 text-muted">{postDate.format(data.date)}</time>
      {data.description && <p class="text-base leading-relaxed text-muted sm:col-span-2">{data.description}</p>}
      {data.tags.length > 0 && (
        <div class="relative z-10 mt-2 w-fit sm:col-span-2"><TagList tags={data.tags} /></div>
      )}
    </li>
  ))}
</ul>
