---
const themes = [
  { id: "creative", label: "Default" },
  { id: "light", label: "Light" },
  { id: "dark", label: "Dark" },
]
---
<details data-theme-picker class="theme-picker">
  <summary aria-label="Theme: Default" class="theme-trigger">
    <svg aria-hidden="true" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
      <g data-mode="light"><circle cx="12" cy="12" r="4" /><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.4 1.4m11.2 11.2L19 19m0-14-1.4 1.4M6.4 17.6 5 19" /></g>
      <g data-mode="dark"><path d="M20.8 15.1A9 9 0 0 1 8.9 3.2a9 9 0 1 0 11.9 11.9Z" /></g>
      <g data-mode="creative"><path d="M10 2l2.3 5.7L18 10l-5.7 2.3L10 18l-2.3-5.7L2 10l5.7-2.3L10 2ZM19 14v8m-4-4h8" /></g>
    </svg>
  </summary>
  <div class="theme-options" role="group" aria-label="Choose a theme">
    {themes.map(({ id, label }) => (
      <button type="button" data-theme-choice={id} aria-pressed={id === "creative"}>
        <span>{label}</span>
        <span aria-hidden="true" class="theme-selected">✓</span>
      </button>
    ))}
  </div>
</details>
