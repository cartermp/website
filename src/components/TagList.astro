---
import { tagPath } from "../lib/site"

interface Props {
  tags: string[]
}

const { tags } = Astro.props
---
{tags.length > 0 && (
  <div class="not-prose flex flex-wrap gap-1.5">
    {tags.map((tag) => (
      <a href={tagPath(tag)} class="rounded-full bg-surface px-2.5 py-0.5 text-xs font-medium text-muted no-underline transition-colors hover:bg-tint hover:text-accent">
        {tag}
      </a>
    ))}
  </div>
)}
