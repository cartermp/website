---
import { siBluesky as BlueskyIcon, siGithub as GithubIcon, siX as XIcon } from "simple-icons"
import { localPath } from "../lib/site"
---
<div aria-label="Social profiles and RSS" role="group" class="mt-5 flex items-center gap-2">
  <a
    href="https://bsky.app/profile/phillipcarter.dev"
    target="_blank"
    rel="noopener noreferrer"
    class="grid size-9 place-items-center rounded-full text-muted transition-colors hover:bg-canvas hover:text-accent"
    aria-label="Bluesky Profile"
  >
    <svg
      width="16"
      height="16"
      viewBox="0 0 24 24"
      class="fill-muted
                 hover:fill-accent
                 transition-colors duration-150"
    >
      <path d={BlueskyIcon.path} />
    </svg>
  </a>
  <a
    href="https://github.com/cartermp"
    target="_blank"
    rel="noopener noreferrer"
    class="grid size-9 place-items-center rounded-full text-muted transition-colors hover:bg-canvas hover:text-accent"
    aria-label="GitHub Profile"
  >
    <svg
      width="16"
      height="16"
      viewBox="0 0 24 24"
      class="fill-muted
                 hover:fill-accent
                 transition-colors duration-150"
    >
      <path d={GithubIcon.path} />
    </svg>
  </a>
  <a
    href="https://x.com/_cartermp"
    target="_blank"
    rel="noopener noreferrer"
    class="grid size-9 place-items-center rounded-full text-muted transition-colors hover:bg-canvas hover:text-accent"
    aria-label="X Profile"
  >
    <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" class="fill-current">
      <path d={XIcon.path} />
    </svg>
  </a>
  <a
    href="https://www.linkedin.com/in/phillip-carter-4714a135"
    target="_blank"
    rel="noopener noreferrer"
    class="grid size-9 place-items-center rounded-full text-muted transition-colors hover:bg-canvas hover:text-accent"
    aria-label="LinkedIn Profile"
  >
    <svg
      width="16"
      height="16"
      viewBox="0 0 448 512"
      class="fill-muted
                 hover:fill-accent
                 transition-colors duration-150"
    >
      <path d="M100.28 448H7.4V148.9h92.88zM53.79 108.1C24.09 108.1 0 83.5 0 53.8a53.79 53.79 0 0 1 107.58 0c0 29.7-24.1 54.3-53.79 54.3zM447.9 448h-92.68V302.4c0-34.7-.7-79.2-48.29-79.2-48.29 0-55.69 37.7-55.69 76.7V448h-92.78V148.9h89.08v40.8h1.3c12.4-23.5 42.69-48.3 87.88-48.3 94 0 111.28 61.9 111.28 142.3V448z" />
    </svg>
  </a>
  <a href={localPath("/rss.xml")} class="ml-1 inline-flex items-center gap-1.5 rounded-full px-2.5 py-1.5 text-sm text-muted transition-colors hover:bg-canvas hover:text-accent">
    <svg aria-hidden="true" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
      <circle cx="5" cy="19" r="1" fill="currentColor" />
      <path d="M4 11a9 9 0 0 1 9 9M4 4a16 16 0 0 1 16 16" />
    </svg>
    RSS
  </a>
</div>
