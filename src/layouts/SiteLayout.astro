---
import "@fontsource-variable/dm-sans"
import "@fontsource-variable/fraunces"
import "../styles/global.css"
import "../styles/creative.css"
import CreativeScene from "../components/CreativeScene.astro"
import { canonicalOrigin, canonicalUrl, description, localPath, title } from "../lib/site"

interface Props {
  pageTitle?: string
  summary?: string
  kind?: "article" | "website"
  noindex?: boolean
}

const { pageTitle = title, summary = description, kind = "website", noindex = false } = Astro.props
const canonical = canonicalUrl(Astro.url.pathname)
const scene = canonical === `${canonicalOrigin}/` ? "home" : kind === "article" ? "article" : "posts"
const image = `${canonicalOrigin}/social-preview.png`
---
<!doctype html>
<html lang="en" data-theme="creative">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={summary} />
    {noindex ? <meta name="robots" content="noindex" /> : (
      <>
        <link rel="canonical" href={canonical} />
        <meta property="og:type" content={kind} />
        <meta property="og:site_name" content={title} />
        <meta property="og:url" content={canonical} />
        <meta property="og:title" content={pageTitle} />
        <meta property="og:description" content={summary} />
        <meta property="og:image" content={image} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content="Phillip Carter — phillipcarter.dev" />
        <meta name="twitter:card" content="summary_large_image" />
      </>
    )}
    <link rel="icon" type="image/png" sizes="48x48" href={localPath("/profile-icon.png")} />
    <link rel="alternate" type="application/rss+xml" title={title} href={localPath("/rss.xml")} />
    <script is:inline>
      (() => {
        const root = document.documentElement
        const system = matchMedia("(prefers-color-scheme: dark)")
        const modes = ["system", "light", "dark", "creative"]
        let mode = root.dataset.theme
        try {
          const saved = localStorage.getItem("theme")
          if (modes.includes(saved)) mode = saved
        } catch {
          // Keep the default when storage is unavailable.
        }

        const applyTheme = () => {
          const dark = mode === "dark" || (mode === "system" && system.matches)
          root.dataset.theme = mode
          root.classList.toggle("dark", dark)
          root.style.colorScheme = dark ? "dark" : "light"
        }

        applyTheme()
        system.addEventListener("change", applyTheme)
        document.addEventListener("DOMContentLoaded", () => {
          const picker = document.querySelector("[data-theme-picker]")
          if (!picker) return
          const trigger = picker.querySelector("summary")
          const choices = [...picker.querySelectorAll("[data-theme-choice]")]
          const updatePicker = () => {
            for (const choice of choices) {
              const selected = choice.dataset.themeChoice === mode
              choice.setAttribute("aria-pressed", String(selected))
              if (selected) trigger.setAttribute("aria-label", `Theme: ${choice.querySelector("span").textContent}`)
            }
          }

          updatePicker()
          picker.dataset.themeReady = ""
          picker.addEventListener("click", (event) => {
            const choice = event.target.closest("[data-theme-choice]")
            if (!choice) return
            mode = choice.dataset.themeChoice
            try { localStorage.setItem("theme", mode) } catch {
              // The selected mode still applies for this page.
            }
            applyTheme()
            updatePicker()
            picker.open = false
            trigger.focus()
          })
          picker.addEventListener("keydown", (event) => {
            if (event.key === "Escape" && picker.open) {
              picker.open = false
              trigger.focus()
            }
          })
          document.addEventListener("click", (event) => {
            if (picker.open && !picker.contains(event.target)) picker.open = false
          })
        }, { once: true })
      })()
    </script>
  </head>
  <body class="min-h-screen bg-canvas font-sans text-ink antialiased">
    <CreativeScene scene={scene} />
    <main class="mx-auto max-w-6xl px-5 py-8 sm:px-8 sm:py-12">
      <slot />
    </main>
    <script>import "../lib/creative-hover"</script>
  </body>
</html>
